{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".\\.cursor\\hooks\\log-cursor.cmd claude",
            "shell": "powershell"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": ".\\.cursor\\hooks\\log-cursor.cmd claude",
            "shell": "powershell"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".\\.cursor\\hooks\\log-cursor.cmd claude",
            "shell": "powershell"
          }
        ]
      }
    ]
  }
}