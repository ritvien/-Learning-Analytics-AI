{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd /c \".cursor\\hooks\\log-cursor.cmd\" claude",
            "shell": "cmd"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "cmd /c \".cursor\\hooks\\log-cursor.cmd\" claude",
            "shell": "cmd"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd /c \".cursor\\hooks\\log-cursor.cmd\" claude",
            "shell": "cmd"
          }
        ]
      }
    ]
  }
}
