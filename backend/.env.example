# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME=EduInsight API
APP_ENV=development          # development | staging | production
DEBUG=false

# ── Database ───────────────────────────────────────────────────────────────────
# Dev  (SQLite async):
DATABASE_URL=sqlite+aiosqlite:///./eduinsight.db
# Prod (PostgreSQL async) — uncomment and fill in:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/eduinsight

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 hours
# Demo Day seed users (seed_users.py on startup). Code default is password123 if unset.
SEED_PASSWORD=123456

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── LLM ────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai            # gemini | openai-compatible providers
LLM_MODEL=gpt-5.4-nano
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=

# ── Agent ──────────────────────────────────────────────────────────────────────
AGENT_ROUTER_MODEL=gpt-5.4-nano
AGENT_CORE_MODEL=gpt-5.4-nano
CHAT_TITLE_MODEL=gpt-5.4-nano
AGENT_DB_URL=postgresql://eduinsight:eduinsight_dev@localhost:5433/eduinsight

# ── Learning-support email delivery (Brevo SMTP demo) ─────────────────────────
# Fill these values, restart backend, then campaign "Gửi email" sends real email.
# Brevo SMTP settings: Settings → SMTP & API → SMTP.
SMTP_ENABLED=false
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_FROM_EMAIL=verified-sender@example.com
SMTP_FROM_NAME=EduInsight
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15

# ── RAG (H63 — CTĐT pgvector) ─────────────────────────────────────────────────
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSION=1536
# Uses OPENAI_API_KEY or LLM_API_KEY for embeddings; GEMINI_API_KEY for OCR (H62)

# ── LangSmith (H59 — Agent Tracing) ───────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=EduInsight
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com  # optional, default

# ── Production deploy (D59 — Render) ───────────────────────────────────────────
# APP_ENV=production
# SEED_ON_EMPTY=true          # keep true for Demo Day; seed skips when students exist
# PORT                        # set by Render (often 10000); do not hardcode 8000
# DATABASE_URL=postgresql+asyncpg://...   # from Render Internal URL (+asyncpg)
# AGENT_DB_URL=postgresql://...           # sync URL for scripts / LangGraph
# CORS_ORIGINS=https://<vercel-app>.vercel.app
