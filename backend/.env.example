# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME=EduInsight API
APP_ENV=development          # development | staging | production
DEBUG=false

# ── Database ───────────────────────────────────────────────────────────────────
# Dev  (SQLite async):
DATABASE_URL=sqlite+aiosqlite:///./eduinsight.db
# Prod (PostgreSQL async) — uncomment and fill in:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/eduinsight

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 hours

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── LLM ────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai            # gemini | openai-compatible providers
LLM_MODEL=gpt-5.4-nano
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=

# ── Agent ──────────────────────────────────────────────────────────────────────
AGENT_ROUTER_MODEL=gpt-5.4-nano
AGENT_CORE_MODEL=gpt-5.4-nano
CHAT_TITLE_MODEL=gpt-5.4-nano
AGENT_DB_URL=postgresql://eduinsight:eduinsight_dev@localhost:5433/eduinsight

# ── RAG (H63 — CTĐT pgvector) ─────────────────────────────────────────────────
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSION=1536
# Uses OPENAI_API_KEY or LLM_API_KEY for embeddings; GEMINI_API_KEY for OCR (H62)

# ── LangSmith (H59 — Agent Tracing) ───────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=EduInsight
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com  # optional, default
