# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME=EduInsight API
APP_ENV=development          # development | staging | production
DEBUG=false

# ── Database ───────────────────────────────────────────────────────────────────
# Dev  (SQLite async):
DATABASE_URL=sqlite+aiosqlite:///./eduinsight.db
# Prod (PostgreSQL async) — uncomment and fill in:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/eduinsight

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 hours

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── LLM ────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai            # gemini | openai-compatible providers, including DeepSeek
LLM_MODEL=deepseek-chat
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1

# ── Agent ──────────────────────────────────────────────────────────────────────
AGENT_ROUTER_MODEL=deepseek-chat
AGENT_CORE_MODEL=deepseek-chat
CHAT_TITLE_MODEL=deepseek-chat
AGENT_DB_URL=postgresql://eduinsight:eduinsight_dev@localhost:5433/eduinsight

# ── Learning-support email delivery (Brevo SMTP demo) ─────────────────────────
# Fill these values, restart backend, then campaign "Gửi email" sends real email.
# Brevo SMTP settings: Settings → SMTP & API → SMTP.
SMTP_ENABLED=false
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_FROM_EMAIL=verified-sender@example.com
SMTP_FROM_NAME=EduInsight
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15
