# Copy to repo root as .env.production on the EC2 host — NEVER commit the real file.
#   cp deploy/.env.production.example .env.production
# Values are read literally (no ${...} substitution): repeat the DB password inside the URLs.

# ── infrastructure ───────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE-ME-long-random
API_DOMAIN=api.yourdomain.com

# ── app core ─────────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
SECRET_KEY=CHANGE-ME-openssl-rand-hex-32
DATABASE_URL=postgresql+asyncpg://eduinsight:CHANGE-ME-long-random@postgres:5432/eduinsight
AGENT_DB_URL=postgresql://eduinsight:CHANGE-ME-long-random@postgres:5432/eduinsight
CORS_ORIGINS=https://c2-app-056.vercel.app

# ── boot behaviour (DB is restored from the Render dump — skip seeding) ──────
SEED_ON_EMPTY=false
IMPORT_V59_STUDENTS=false
RUN_ANALYTICS_REFRESH_ON_STARTUP=false
SEED_PASSWORD=123456

# ── ML / dashboards ──────────────────────────────────────────────────────────
ML_ARTIFACT_DIR=/data/ml_artifacts
DASHBOARD_CACHE_TTL_SECONDS=21600
DASHBOARD_PREWARM_INTERVAL_SECONDS=300
TREE_CACHE_TTL_SECONDS=900

# ── LLM / observability ──────────────────────────────────────────────────────
OPENAI_API_KEY=
LLM_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=eduinsight-s4-demo

# ── misc ─────────────────────────────────────────────────────────────────────
SMTP_ENABLED=false
